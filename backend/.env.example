# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:dev@localhost:5432/goexpressly

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Email ───────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: "resend" (production) or "smtp" (local dev via Mailtrap)
EMAIL_PROVIDER=smtp

# Resend (production)
RESEND_API_KEY=re_your_api_key_here

# SMTP (Mailtrap dev sandbox — https://mailtrap.io)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password

FROM_EMAIL=noreply@goexpressly.com
